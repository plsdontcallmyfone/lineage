#!/bin/bash
# desk-stop <name> <INT|KILL> [wait seconds]: signal a desk-bg process and wait for it to exit.
n="$(basename -- "$1")"; sig="${2:-INT}"; w="${3:-15}"
f="/tmp/desk/$n.pid"; [ -f "$f" ] || exit 0
p="$(cat "$f")"
kill -s "$sig" "$p" 2>/dev/null || { rm -f "$f"; exit 0; }
for i in $(seq 1 $((w * 10))); do kill -0 "$p" 2>/dev/null || break; sleep 0.1; done
kill -0 "$p" 2>/dev/null && kill -s KILL "$p" 2>/dev/null
rm -f "$f"
