+/// Logs "reallocating +N bytes" exactly as `msg!("reallocating +{:?} bytes", n)` did, without
+/// core::fmt and the heap String that `msg!` with arguments formats into.
+fn log_realloc(added: usize) {
+    const HEAD: &[u8] = b"reallocating +";
+    const TAIL: &[u8] = b" bytes";
+    let mut digits = [0u8; 20];
+    let mut i = digits.len();
+    let mut n = added;
+    loop {
+        i -= 1;
+        digits[i] = b'0' + (n % 10) as u8;
+        n /= 10;
+        if n == 0 {
+            break;
+        }
+    }
+    let mut line = [0u8; 40];
+    let mut len = 0;
+    for part in [HEAD, &digits[i..], TAIL] {
+        line[len..len + part.len()].copy_from_slice(part);
+        len += part.len();
+    }
+    if let Ok(text) = core::str::from_utf8(&line[..len]) {
+        solana_msg::sol_log(text);
+    }
+}
