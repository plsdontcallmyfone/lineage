+/// Number of codepoints `printParam` writes for `param`, computed without writing anything.
+fn paramWidth(comptime Id: type, param: Param(Id)) std.Io.Writer.Error!usize {
+    var res: usize = 0;
+    if (param.names.short != null or param.names.long != null) {
+        res += 2;
+        if (param.names.long) |l|
+            res += 4 + try countCodepoints(l);
+        if (param.takes_value != .none)
+            res += 1;
+    }
+
+    if (param.takes_value == .none)
+        return res;
+
+    res += 2 + try countCodepoints(param.id.value());
+    if (param.takes_value == .many)
+        res += 3;
+    return res;
+}
+
+fn countCodepoints(s: []const u8) std.Io.Writer.Error!usize {
+    const r = ccw.utf8CountCodepointsAllowTruncate(s) catch return error.WriteFailed;
+    if (r.bytes != s.len) return error.WriteFailed;
+    return r.codepoints;
+}
