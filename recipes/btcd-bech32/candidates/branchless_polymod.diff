+// polymodStep feeds one 5-bit value into the checksum state. Each generator term
+// is xored in under a mask made from its bit of the top five state bits, so the
+// step has no data-dependent branches.
+func polymodStep(chk, v int) int {
+	b := chk >> 25
+	chk = (chk&0x1ffffff)<<5 ^ v
+	chk ^= -(b & 1) & 0x3b6a57b2
+	chk ^= -(b >> 1 & 1) & 0x26508e6d
+	chk ^= -(b >> 2 & 1) & 0x1ea119fa
+	chk ^= -(b >> 3 & 1) & 0x3d4233dd
+	chk ^= -(b >> 4 & 1) & 0x2a1462b3
+	return chk
+}
