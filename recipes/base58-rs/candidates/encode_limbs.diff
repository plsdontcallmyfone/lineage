+const BIG: u64 = 58 * 58 * 58 * 58 * 58; // 656_356_768, below 2^30
+
+/// limbs = limbs * mul + add, limbs little-endian in base 58^5. With limbs below 2^30 and
+/// mul at most 2^32, every intermediate stays below 2^63.
+fn mul_add(limbs: &mut Vec<u64>, mul: u64, add: u64) {
+	let mut carry = add;
+	for l in limbs.iter_mut() {
+		let t = *l * mul + carry;
+		*l = t % BIG;
+		carry = t / BIG;
+	}
+	while carry != 0 {
+		limbs.push(carry % BIG);
+		carry /= BIG;
+	}
+}
