+def _update_stats_str(stats, old, new, pair, idx):
+    """
+    Same as _update_stats, for sequences stored as str (one chr(token) per
+    token), where new = old.replace(chr(p0) + chr(p1), chr(idx)).
+    """
+    p0, p1 = pair
+    get = stats.get
+    n_old = len(old)
+    c = chr(idx)
+    k = new.count(c)
+    find = new.find
+    removed = [pair]
+    rapp = removed.append
+    prev = -2
+    q = -1
+    for m in range(k):
+        q = find(c, q + 1)
+        j = q + m # position of this occurrence in old
+        if q and prev != q - 1:
+            a = ord(new[q-1])
+            p = (a, p0)
+            stats[p] -= 1
+            rapp(p)
+            p = (a, idx)
+            stats[p] = get(p, 0) + 1
+        if j + 2 < n_old:
+            p = (p1, ord(old[j+2]))
+            stats[p] -= 1
+            rapp(p)
+            p = (idx, ord(new[q+1]))
+            stats[p] = get(p, 0) + 1
+        prev = q
+    stats[pair] -= k
+    for p in removed:
+        if get(p) == 0:
+            del stats[p]
