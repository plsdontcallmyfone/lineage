+            # read the merges (all at once in C when every line has two fields)
+            lines = f.read().split("\n")
+            if lines[-1] == "":
+                lines.pop()
+            fields = list(map(str.split, lines))
+            if set(map(len, fields)) <= {2}:
+                it = map(int, chain.from_iterable(fields))
+                merges.update(zip(zip(it, it), range(idx, idx + len(lines))))
+            else:
+                for line in lines:
+                    idx1, idx2 = map(int, line.split())
+                    merges[(idx1, idx2)] = idx
+                    idx += 1
         self.merges = merges
         self.special_tokens = special_tokens
         self.vocab = self._build_vocab()
