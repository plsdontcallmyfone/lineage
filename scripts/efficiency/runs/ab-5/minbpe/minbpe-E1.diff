+
+
+# last (merges snapshot, table) pair: encode calls with unchanged merges reuse
+# the table instead of re-sorting and rebuilding it (the snapshot is a private
+# copy, so the table is only reused for merges that are exactly equal)
+_table_cache = [None, None]
+
+
+def _cached_replace_table(merges):
+    if _table_cache[0] != merges:
+        _table_cache[:] = dict(merges), _replace_table(merges)
+    return _table_cache[1]
