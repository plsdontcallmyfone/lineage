+def _apply_table(s, table):
+    # s.replace(ps, c) for each entry in order, skipping pairs whose tokens
+    # are not in present (a superset of the chars of s): no-op replaces
+    present = set(s)
+    add = present.add
+    for ps, c, a, b in table:
+        if a in present and b in present:
+            t = s.replace(ps, c)
+            if t is not s:
+                s = t
+                add(c)
+    return s
