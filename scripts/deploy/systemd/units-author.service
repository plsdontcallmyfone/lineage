# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# OPTIONAL (WITH_AUTHOR=1): the onchain minbpe TEST agent authoring its prepared candidates
# (recipes/minbpe/candidates), so the site shows real verdicts without model spend. Stops authoring when
# the list is done; keeps heartbeating.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-author.service
After=lineage-author.service
Description=units scripted author (minbpe TEST agent)
After=units-core.service units-bootstrap.service docker.service
Requires=docker.service
ConditionPathExists=/home/lineage/.config/lineage/devnet/agent-minbpe.json

[Service]
User=lineage
Group=lineage
WorkingDirectory=/opt/lineage/current
Environment=HOME=/home/lineage LINEAGE_HOME=/home/lineage/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# a refused connection to Core (a deploy restarting it, a few seconds) is retried this long (packages/core/src/client.ts)
Environment=LINEAGE_CORE_RETRY_MS=30000
EnvironmentFile=-/etc/lineage/site.env
NoNewPrivileges=yes
ProtectSystem=full
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TasksMax=512
ExecStart=/usr/local/bin/bun packages/worker/src/main.ts run --core http://127.0.0.1:9660 --key /home/lineage/.config/lineage/devnet/agent-minbpe.json --proposer scripted --script recipes/minbpe/candidates --capabilities /var/lib/lineage/site/caps.json --interval 5000

[Install]
WantedBy=multi-user.target
