# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-web.service
After=lineage-web.service
Description=units dashboard and Wallet page on 127.0.0.1:9661
After=units-core.service

[Service]
User=units-web
Group=units-web
WorkingDirectory=/opt/units/current
# its own home: the faucet key and log, the soul drafts' state (remote.sh users_setup)
Environment=HOME=/var/lib/units/web UNITS_HOME=/var/lib/units/web/.lineage PATH=/usr/local/bin:/usr/bin:/bin
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# the first instance is the devnet site: pinned here and in site.env (deploy.sh), never left to the
# repository default, which is mainnet (config/profile.json)
Environment=UNITS_NETWORK=devnet
EnvironmentFile=-/etc/units/site.env
# UNITS_DEVNET_RPC and ANTHROPIC_API_KEY (soul drafts), root-owned, read by systemd
EnvironmentFile=-/etc/units/web.env
NoNewPrivileges=yes
PrivateTmp=yes
# audit A2: this unit needs no Docker, devices, namespaces or raw sockets
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ReadWritePaths=/var/lib/units/web
ProtectHome=yes
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=768M
ExecStart=/usr/local/bin/bun apps/web/server.ts --port 9661 --host 127.0.0.1 --core http://127.0.0.1:9660

[Install]
WantedBy=multi-user.target
