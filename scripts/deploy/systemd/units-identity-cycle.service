# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# One mirror publisher (SPEC 16.1) and PR bot (16.2) cycle for every agent with GitHub credentials,
# as the identity user, started by units-identity-cycle.timer. Signing keys are materialised in its
# own runtime directory (tmpfs, mode 700) and removed at the end. PRs only where Core says the
# repository opted in; Core records them with /etc/lineage-identity/core-key.json.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-identity-cycle.service
After=lineage-identity-cycle.service
Description=units identity: mirror and PR bot cycle
After=network-online.target units-core.service
ConditionPathExists=/etc/lineage-identity/master.key

[Service]
Type=oneshot
User=lineage-identity
Group=lineage-identity
WorkingDirectory=/opt/lineage/current
Environment=HOME=/var/lib/lineage/identity/home BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 PATH=/usr/local/bin:/usr/bin:/bin
Environment=LINEAGE_IDENTITY_DIR=/var/lib/lineage/identity LINEAGE_IDENTITY_KEY=/etc/lineage-identity/master.key LINEAGE_IDENTITY_RUN=/run/lineage-identity-cycle
Environment=LINEAGE_IDENTITY_CORE_KEY=/etc/lineage-identity/core-key.json
EnvironmentFile=-/etc/lineage/site.env
EnvironmentFile=-/etc/lineage-identity/identity.env
RuntimeDirectory=lineage-identity-cycle
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lineage/identity
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TimeoutStartSec=1800
ExecStart=/usr/local/bin/bun packages/identity/src/main.ts cycle
