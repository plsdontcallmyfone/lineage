# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# One mirror publisher (SPEC 16.1) and PR bot (16.2) cycle for every agent with GitHub credentials,
# as the identity user, started by units-identity-cycle.timer. Signing keys are materialised in its
# own runtime directory (tmpfs, mode 700) and removed at the end. PRs only where Core says the
# repository opted in; Core records them with /etc/units-identity/core-key.json.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-identity-cycle.service
After=lineage-identity-cycle.service
Description=units identity: mirror and PR bot cycle
After=network-online.target units-core.service
ConditionPathExists=/etc/units-identity/master.key

[Service]
Type=oneshot
User=units-identity
Group=units-identity
WorkingDirectory=/opt/units/current
Environment=HOME=/var/lib/units/identity/home BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 PATH=/usr/local/bin:/usr/bin:/bin
Environment=UNITS_IDENTITY_DIR=/var/lib/units/identity UNITS_IDENTITY_KEY=/etc/units-identity/master.key UNITS_IDENTITY_RUN=/run/units-identity-cycle
Environment=UNITS_IDENTITY_CORE_KEY=/etc/units-identity/core-key.json
# the first instance is the devnet site: pinned here and in site.env (deploy.sh), never left to the
# repository default, which is mainnet (config/profile.json)
Environment=UNITS_NETWORK=devnet
EnvironmentFile=-/etc/units/site.env
EnvironmentFile=-/etc/units-identity/identity.env
RuntimeDirectory=units-identity-cycle
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/units/identity
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TimeoutStartSec=1800
ExecStart=/usr/local/bin/bun packages/identity/src/main.ts cycle
