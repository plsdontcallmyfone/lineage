# Installed by scripts/deploy/remote.sh. Lineage public devnet site, docs/DEPLOY-SITE.md "Backups".
# The "state" part of the secrets+state snapshot (scripts/deploy/backup.sh secrets): the hosted runtime's
# agent keys and state and the site's own keys, as lineage (their owner), staged in RAM and encrypted
# with age to the owner's public recipient in /etc/lineage/backup-recipient.txt. Started with
# lineage-backup.service (hourly by its timer); the newest 24 are kept in /var/lib/lineage/state-backups.
[Unit]
Description=Lineage secrets+state snapshot (runtime and site keys)
ConditionPathExists=/etc/lineage/backup-recipient.txt

[Service]
Type=oneshot
User=lineage
Group=lineage
UMask=0077
WorkingDirectory=/opt/lineage/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/lineage
RuntimeDirectory=lineage-backup-state
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/lineage/state-backups
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
TimeoutStartSec=600
ExecStart=/bin/bash scripts/deploy/backup.sh secrets state --out /var/lib/lineage/state-backups --keep 24
