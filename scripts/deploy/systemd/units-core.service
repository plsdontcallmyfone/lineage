# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# Runs as units-core (no docker, no login; audit OFF-D10): its data in /var/lib/units/core, its keys
# and network.json in /etc/units-core (remote.sh users_setup). Group lineage gives it read access to the
# workers' git mirrors (the tree view, UNITS_HOME) and the private canaries; nothing in /home is
# writable and lineage's key directory is hidden.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-core.service
After=lineage-core.service
Description=units Core (devnet chain mode) on 127.0.0.1:9660
After=network-online.target
Wants=network-online.target

[Service]
User=units-core
# primary group lineage: its files stay readable to a release from before the service users
Group=units
UMask=0007
WorkingDirectory=/opt/units/current
Environment=HOME=/var/lib/units/core UNITS_HOME=/home/units/.lineage PATH=/usr/local/bin:/usr/bin:/bin
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# live stream viewer counts: Core samples the gate's counts once a minute (packages/core/src/viewers.ts)
Environment=UNITS_GATE_URL=http://127.0.0.1:9662
# the mirrors belong to lineage; git refuses another owner's repository unless it is marked safe
Environment=GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=*
EnvironmentFile=-/etc/units/site.env
# Core's read-only GitHub token (UNITS_GITHUB_TOKEN; owner-installed, root 600, optional)
EnvironmentFile=-/etc/units/core-github.env
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/units/core
ProtectHome=read-only
InaccessiblePaths=-/home/units/.config -/home/units/.ssh
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TasksMax=512
ExecStart=/usr/local/bin/bun packages/core/src/main.ts --data /var/lib/units/core --port 9660 --host 127.0.0.1 --config /etc/units-core/network.json --admin-key /etc/units-core/admin.json --runtime-key /var/lib/units/site/runtime-authority.pub --canaries-dir /var/lib/units/canaries

[Install]
WantedBy=multi-user.target
