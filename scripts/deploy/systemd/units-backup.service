# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md "Backups".
# A consistent snapshot of Core's database and blob store (scripts/deploy/backup.sh) into
# /var/lib/lineage/core-backups, the newest 24 kept; `deploy.sh <host> backup` copies the newest one
# off the machine and verifies it. Starting it also starts the two secrets+state parts (each as the
# user that owns its data): units-backup-state.service and units-backup-identity.service.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-backup.service
After=lineage-backup.service
Description=units Core snapshot
After=units-core.service
Wants=units-backup-state.service units-backup-identity.service

[Service]
Type=oneshot
User=lineage-core
Group=lineage-core
UMask=0077
WorkingDirectory=/opt/lineage/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin HOME=/var/lib/lineage/core
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lineage/core /var/lib/lineage/core-backups
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=1800
ExecStart=/bin/bash scripts/deploy/backup.sh snapshot --data /var/lib/lineage/core --out /var/lib/lineage/core-backups --keep 24
