# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# The bind service (packages/runtime/src/bind-service.ts, docs/plans/SEAMLESS-BIND.md section 9): the
# hosted runtime's bind surface as its own small process, so a hosted launch gets its runtime key and
# its co-signature while units-runtime drains (up to 25 minutes at a deploy), restarts or is off.
# A PUBLIC unit: restarted one by one with the others and health-checked (remote.sh restart_checked),
# never drained, never stopped with the workers. It runs as the runtime's user on the runtime's state
# directory (the shared key store), reads no runtime authority key, no model key and no provider key,
# and needs no Docker.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-bind.service
After=lineage-bind.service
Description=units bind service (devnet): runtime keys and co-signatures for hosted launches on 127.0.0.1:9666
After=network-online.target
# a hosted-runtime instance only: the same key file units-runtime is conditioned on (never read here)
ConditionPathExists=/home/units/.config/lineage/devnet/runtime-authority.json
ConditionPathExists=/var/lib/units/site/runtime.json

[Service]
User=units
Group=units
WorkingDirectory=/opt/units/current
Environment=HOME=/home/units UNITS_HOME=/home/units/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# the first instance is the devnet site: pinned here and in site.env (deploy.sh), never left to the
# repository default, which is mainnet (config/profile.json)
Environment=UNITS_NETWORK=devnet
EnvironmentFile=-/etc/units/site.env
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
# a restart is a few hundred milliseconds; the gate waits out a refused dial meanwhile (gate.ts fetchUpstream)
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
MemoryMax=512M
TasksMax=256
KillSignal=SIGTERM
# requests in flight finish (2 s at most, bind-service.ts); nothing here drains
TimeoutStopSec=10
ExecStart=/usr/local/bin/bun packages/runtime/src/main.ts bind --config /var/lib/units/site/runtime.json --port 9666

[Install]
WantedBy=multi-user.target
