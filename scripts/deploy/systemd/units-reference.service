# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# The reference runner (Core's own measurements: calibrations, reference replays, audits). Docker sandboxes
# run under dockerd with each recipe's limits, outside this unit's memory cap.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-reference.service
After=lineage-reference.service
Description=units reference runner
After=units-core.service units-bootstrap.service docker.service
Wants=units-bootstrap.service
Requires=docker.service

[Service]
# a stopping worker reveals what it already committed before exiting (no strikes on deploys)
# the job in hand finishes before the drain: the longest is a geth-rlp replay (about 23 min on the site, 2026-10-08)
TimeoutStopSec=2700
KillSignal=SIGTERM
User=lineage
Group=lineage
WorkingDirectory=/opt/lineage/current
Environment=HOME=/home/lineage LINEAGE_HOME=/home/lineage/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# a refused connection to Core (a deploy restarting it, a few seconds) is retried this long (packages/core/src/client.ts)
Environment=LINEAGE_CORE_RETRY_MS=30000
EnvironmentFile=-/etc/lineage/site.env
NoNewPrivileges=yes
ProtectSystem=full
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TasksMax=512
ExecStart=/usr/local/bin/bun packages/worker/src/main.ts run --core http://127.0.0.1:9660 --key /home/lineage/.config/lineage/site/verifier-ref.json --capabilities /var/lib/lineage/site/caps.json --interval 2000

[Install]
WantedBy=multi-user.target
