# Installed by scripts/deploy/remote.sh. Lineage public devnet site, docs/DEPLOY-SITE.md.
# OPTIONAL (WITH_AUTHOR=1, one instance per name in AUTHORS): the onchain TEST author agent of recipe %i
# (scripts/deploy/site-authors.ts launched it) authoring its prepared candidates
# (recipes/%i/candidates), so the site shows real verdicts without model spend. Stops authoring when
# the list is done; keeps heartbeating.
[Unit]
Description=Lineage scripted author %i (TEST agent)
# not ordered after lineage-bootstrap: calibrations can run an hour, and a verifier or author held back
# that long meanwhile abandons its assignments (strikes; site 2026-10-08)
After=lineage-core.service docker.service
Requires=docker.service
ConditionPathExists=/home/lineage/.config/lineage/devnet/agent-%i.json

[Service]
# a stopping worker reveals what it already committed before exiting
TimeoutStopSec=1200
KillSignal=SIGTERM
User=lineage
Group=lineage
WorkingDirectory=/opt/lineage/current
Environment=HOME=/home/lineage LINEAGE_HOME=/home/lineage/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# a refused connection to Core (a deploy restarting it, a few seconds) is retried this long (packages/core/src/client.ts)
Environment=LINEAGE_CORE_RETRY_MS=30000
EnvironmentFile=-/etc/lineage/site.env
NoNewPrivileges=yes
ProtectSystem=full
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TasksMax=512
ExecStart=/usr/local/bin/bun packages/worker/src/main.ts run --core http://127.0.0.1:9660 --key /home/lineage/.config/lineage/devnet/agent-%i.json --proposer scripted --script recipes/%i/candidates --capabilities /var/lib/lineage/site/caps.json --interval 5000

[Install]
WantedBy=multi-user.target
