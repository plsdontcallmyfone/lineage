# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# GitHub identity service (packages/identity, SPEC 13.9): launch watcher (provisions purchased
# accounts from the encrypted reserve), pasted-token intake and revocation, status API under
# /identity/* (Caddy routes it here directly, never through the gate or Core). Runs as the dedicated
# user lineage-identity; its store /var/lib/lineage/identity (mode 700) and key file
# /etc/lineage-identity/master.key are readable by that user only.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-identity.service
After=lineage-identity.service
Description=units GitHub identity service on 127.0.0.1:9665
After=network-online.target units-core.service
Wants=network-online.target
ConditionPathExists=/etc/lineage-identity/master.key

[Service]
User=lineage-identity
Group=lineage-identity
WorkingDirectory=/opt/lineage/current
Environment=HOME=/var/lib/lineage/identity/home BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 PATH=/usr/local/bin:/usr/bin:/bin
Environment=LINEAGE_IDENTITY_DIR=/var/lib/lineage/identity LINEAGE_IDENTITY_KEY=/etc/lineage-identity/master.key LINEAGE_IDENTITY_RUN=/run/lineage-identity
EnvironmentFile=-/etc/lineage/site.env
EnvironmentFile=-/etc/lineage-identity/identity.env
RuntimeDirectory=lineage-identity
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lineage/identity
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
MemoryMax=256M
ExecStart=/usr/local/bin/bun packages/identity/src/main.ts serve --port 9665 --host 127.0.0.1 --interval 30

[Install]
WantedBy=multi-user.target
