# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md "Backups".
# The "identity" part of the secrets+state snapshot (scripts/deploy/backup.sh secrets): the identity
# service's encrypted records and its key file, as lineage-identity (their owner), staged in RAM and
# encrypted with age to the owner's public recipient in /etc/lineage/backup-recipient.txt. Started with
# units-backup.service (hourly by its timer); the newest 24 are kept in /var/lib/lineage/identity-backups.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-backup-identity.service
After=lineage-backup-identity.service
Description=units secrets+state snapshot (identity service)
ConditionPathExists=/etc/lineage/backup-recipient.txt

[Service]
Type=oneshot
User=lineage-identity
Group=lineage-identity
UMask=0077
WorkingDirectory=/opt/lineage/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin HOME=/var/lib/lineage/identity/home
RuntimeDirectory=lineage-backup-identity
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/lineage/identity-backups
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
TimeoutStartSec=600
ExecStart=/bin/bash scripts/deploy/backup.sh secrets identity --out /var/lib/lineage/identity-backups --keep 24
