# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md.
# One shot per deploy: recipes, snapshots and calibrations by the reference runner (creates the lineages).
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-bootstrap.service
After=lineage-bootstrap.service
Description=units site bootstrap (lineages for UNITS_RECIPES)
After=units-core.service docker.service
Requires=docker.service

[Service]
User=units
Group=units
WorkingDirectory=/opt/units/current
Environment=HOME=/home/units UNITS_HOME=/home/units/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# the first instance is the devnet site: pinned here and in site.env (deploy.sh), never left to the
# repository default, which is mainnet (config/profile.json)
Environment=UNITS_NETWORK=devnet
EnvironmentFile=-/etc/units/site.env
NoNewPrivileges=yes
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
MemoryMax=1G
ExecStart=/usr/local/bin/bun scripts/deploy/site-bootstrap.ts --core http://127.0.0.1:9660 --caps /var/lib/units/site/caps.json --recipes ${UNITS_RECIPES}
