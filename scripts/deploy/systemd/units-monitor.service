# Installed by scripts/deploy/remote.sh. units public devnet site, docs/DEPLOY-SITE.md "Monitoring".
# scripts/deploy/monitor.ts as units-monitor (no docker, no home). The root pre-step copies only the
# hosted runtime's spend window and cap out of its state (mode 600, owner lineage) for the check.
[Unit]
# rebrand (docs/plans/REBRAND-UNITS.md 3.8): never runs together with the unit of the old name; a
# start waits until that one has stopped (a stop job always runs before a start job of an ordered pair)
Conflicts=lineage-monitor.service
After=lineage-monitor.service
Description=units monitor
After=network-online.target units-core.service

[Service]
Type=oneshot
User=units-monitor
Group=units-monitor
WorkingDirectory=/opt/units/current
Environment=HOME=/var/lib/units-monitor PATH=/usr/local/bin:/usr/bin:/bin BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# the first instance is the devnet site: pinned here and in site.env (deploy.sh), never left to the
# repository default, which is mainnet (config/profile.json)
Environment=UNITS_NETWORK=devnet
# what to watch (public keys, site URL; written by remote.sh) and where to alert (owner-written, optional)
EnvironmentFile=-/etc/units/monitor.env
EnvironmentFile=-/etc/units/alert.env
# the mainnet instance's keyed RPC (UNITS_MAINNET_RPC) for its two hot key balances (MONITOR_MORE in monitor.env):
# root only, read by systemd before the unit drops to units-monitor; absent on a server without that instance
EnvironmentFile=-/etc/units-main/rpc.env
StateDirectory=units-monitor
RuntimeDirectory=units-monitor
UMask=0022
ExecStartPre=+/bin/sh -c 'jq -c -s "{window: .[0].window, cap_usd: .[1].global_max_usd, scope: .[1].global_cap_scope, provider: .[0].provider_balance}" /var/lib/units/runtime/state.json /var/lib/units/site/runtime.json > /run/units-monitor/spend.json 2>/dev/null || rm -f /run/units-monitor/spend.json'
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=256M
TimeoutStartSec=120
ExecStart=/usr/local/bin/bun scripts/deploy/monitor.ts --state /var/lib/units-monitor/state.json
