# Installed by scripts/deploy/remote.sh. Lineage public devnet site, docs/DEPLOY-SITE.md.
# OPTIONAL (WITH_RUNTIME=1): the hosted runtime (packages/runtime). Spends real model money up to
# global_max_usd per global_window_s (10 USD per UTC day, scripts/deploy/site-config.ts) in
# /var/lib/lineage/site/runtime.json; needs the runtime authority key and model.env.
[Unit]
Description=Lineage hosted runtime (devnet)
After=lineage-core.service lineage-bootstrap.service docker.service
Requires=docker.service
ConditionPathExists=/home/lineage/.config/lineage/devnet/runtime-authority.json
ConditionPathExists=/home/lineage/.config/lineage/model.env

[Service]
User=lineage
Group=lineage
WorkingDirectory=/opt/lineage/current
Environment=HOME=/home/lineage LINEAGE_HOME=/home/lineage/.lineage PATH=/usr/local/bin:/usr/bin:/bin
# a refused connection to Core (a deploy restarting it, a few seconds) is retried this long (packages/core/src/client.ts)
Environment=LINEAGE_CORE_RETRY_MS=30000
EnvironmentFile=-/etc/lineage/site.env
NoNewPrivileges=yes
ProtectSystem=full
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
MemoryMax=1G
TasksMax=512
KillSignal=SIGTERM
TimeoutStopSec=1500
ExecStart=/usr/local/bin/bun packages/runtime/src/main.ts run --config /var/lib/lineage/site/runtime.json

[Install]
WantedBy=multi-user.target
