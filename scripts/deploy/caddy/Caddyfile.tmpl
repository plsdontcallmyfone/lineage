# Rendered by scripts/deploy/remote.sh into /etc/caddy/Caddyfile. Lineage public devnet site.
# The site list is "<ip-with-dashes>.sslip.io" plus DOMAIN when given (Let's Encrypt certificates), or
# "localhost" with internal TLS in the dry run. Everything goes to the gate on 127.0.0.1:9662 (which sends
# /market/* on to the market indexer on 127.0.0.1:9668).
# The admin API listens on a unix socket, mode 0600, owner caddy, in /run/caddy (RuntimeDirectory in the
# caddy.service drop-in remote.sh writes), not on localhost:2019 where any local process could rewrite
# the proxy (audit OFF-D12). The packaged unit's `caddy reload` runs as caddy and reads this address
# from the config it loads.
{
	admin unix//run/caddy/admin.sock|0600
@GLOBAL@
}

@SITES@ {
@TLS@
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type text/markdown*
			header Content-Type image/svg+xml*
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# audit A2: every page is built from strings on the origin that also builds wallet transactions,
		# so scripts come only from this origin (plus the one inline theme script in index.html, by
		# hash; recompute it if that script changes). The embed demo's inline config script is blocked
		# on purpose (its ?api= override let a link point the site's own page at foreign data).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-q2c/Ljs7mm4Cb9opxfKMH7RGkjkXZyTffr036UKMi2k='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.privy.io; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.github.com https://auth.privy.io https://*.rpc.privy.systems https://api.devnet.solana.com wss://api.devnet.solana.com wss://relay.walletconnect.com wss://relay.walletconnect.org https://explorer-api.walletconnect.com; frame-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; child-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# a launcher's profile image (POST /social/media/<agent>, base64 in JSON) may be up to 1.5 MB; the gate
	# caps it again per route
	@not_media not path /social/media/*
	request_body @not_media {
		max_size 256KB
	}
	request_body /social/media/* {
		max_size 1600KB
	}
	# /market/* goes through the gate like everything else (rate limits per client; audit A2), which
	# sends it on to the market indexer (packages/indexer, units-indexer.service) on 127.0.0.1:9668
	# GitHub identity service (packages/identity, units-identity.service): pasted tokens go here only, never to the gate or Core
	# lb_try_duration: while a deploy restarts the gate or the identity service (well under a second each;
	# docs/DEPLOY-SITE.md "Zero-downtime activate"), a refused dial is retried every 250 ms for up to 15 s
	# instead of answering 502. Writes go without it: to retry, Caddy buffers the body, and a body over
	# the request_body cap then fails as 502 instead of 413
	reverse_proxy /identity/* 127.0.0.1:9665 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
	@write method POST PUT PATCH DELETE
	reverse_proxy @write 127.0.0.1:9662 {
		flush_interval -1
	}
	reverse_proxy 127.0.0.1:9662 {
		flush_interval -1
		lb_try_duration 15s
		lb_try_interval 250ms
	}
	log {
		output file /var/log/caddy/lineage-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
