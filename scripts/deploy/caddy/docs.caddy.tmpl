# Rendered by scripts/docs/deploy.sh into /etc/caddy/sites.d/units-docs.caddy, which the main
# Caddyfile imports (scripts/deploy/caddy/Caddyfile.tmpl, last line). The docs are a web site of their
# own (apps/docs, scripts/docs/build.ts): static files served straight from @ROOT@ (a link to the
# release scripts/docs/deploy.sh last put there), nothing proxied, no app unit involved. App deploys
# keep this file as it is. Hosts: docs.units.gg, whose certificate Caddy obtains by itself once the
# DNS record points here (A docs.units.gg -> this server), and the temporary host on sslip.io.
(units_docs_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# the docs' own page policy (scripts/docs/build.ts docsCsp): scripts, styles, fonts and images of
		# this site only, no inline script, and reads of the live figures from the app origin
		Content-Security-Policy "@CSP@"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

@SITES@ {
@TLS@
	root * @ROOT@
	encode zstd gzip
	import units_docs_headers

	# a static site: reads only
	@write not method GET HEAD
	respond @write "method not allowed" 405

	# cache rules (scripts/docs/build.ts DOCS_CACHE): every file under /assets carries a hash of its
	# content in its name, so it never changes; pages are revalidated on every visit
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=2592000"
	@media path /shots/* /providers/* /favicon.png /logo.png
	header @media Cache-Control "public, max-age=3600"
	@pages not path /assets/* /fonts/* /shots/* /providers/* /favicon.png /logo.png
	header @pages Cache-Control "no-cache"

	# clean URLs: /verification is verification.html; the .html and trailing-slash spellings redirect
	@index path /index /index.html
	redir @index / 308
	@html path_regexp html ^/([a-z0-9-]+)\.html$
	redir @html /{re.html.1} 308
	@slash {
		path_regexp slash ^/([a-z0-9-]+)/$
		not path /assets/ /fonts/ /shots/ /providers/
	}
	redir @slash /{re.slash.1} 308
	# the build's Vercel file is not part of the site
	@private path /vercel.json
	error @private 404

	try_files {path} {path}.html
	file_server

	# an unknown path gets the docs' own 404 page with status 404
	handle_errors {
		import units_docs_headers
		header Cache-Control "no-cache"
		@missing expression `{err.status_code} == 404`
		handle @missing {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
	log {
		output file /var/log/caddy/units-docs-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
