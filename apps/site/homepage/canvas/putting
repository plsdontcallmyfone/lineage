    <!-- Boot watchdog (paired with window.__APP_BOOTED__ in src/main.tsx).
         After a deploy ships new hashed chunks, a browser still holding the
         previous build's HTML 404s on the entry bundle and the app never boots.
         The in-app stale-chunk handler can't help because it lives inside that
         bundle, so this inline guard reloads ONCE to pull fresh HTML. Shares the
         30s sessionStorage loop-guard key with src/lib/stale-chunk-reload.ts so
         the two never double-reload. Verified 2026-06-15: no false-fire on a
         healthy load, exactly one reload on a 404, loop guard holds.
         CSP: this script is allowed by a sha256 hash in apps/web/vercel.json
         (script-src). ANY byte change to the script body below (including
         whitespace) breaks the hash and the CSP blocks the watchdog once the
         policy is enforced. Recompute: sha256 of the exact text between the
         script tags, base64-encoded. -->
    <script>
      (function () {
        var KEY = 'plnty:chunk-reload-attempt', GUARD_MS = 30000;
        function reloadOnce(reason) {
          try {
            var last = Number(sessionStorage.getItem(KEY) || '0');
            if (Date.now() - last < GUARD_MS) return false;
            sessionStorage.setItem(KEY, String(Date.now()));
          } catch (e) { return false; }
          console.warn('[boot-watchdog] reloading after entry-load failure: ' + reason);
          location.reload();
          return true;
        }
        // Fast path: a failed entry/module <script> or stylesheet <link> fires a
        // resource error on window in the capture phase. Reload immediately.
        window.addEventListener('error', function (e) {
          // Pre-boot detector ONLY. Once main.tsx sets __APP_BOOTED__, late
          // resource failures (e.g. a font/stylesheet <link> blocked by a
          // corporate firewall / VPN, firing ~10-15s in) are NOT entry-load
          // failures — reloading here would discard the user's unsaved canvas
          // work. Post-boot dynamic-chunk 404s are handled by the in-app
          // stale-chunk-reload.ts instead.
          if (window.__APP_BOOTED__) return;
          var t = e && e.target;
          if (t && (t.tagName === 'SCRIPT' || t.tagName === 'LINK')) {
            reloadOnce('resource:' + (t.src || t.href || t.tagName));
          }
        }, true);
        // Backstop: if main.tsx never set __APP_BOOTED__, the entry stalled or
        // failed without an error event. Generous timeout so a slow (but working)
        // load is never reloaded out from under the user.
        window.setTimeout(function () {
          if (!window.__APP_BOOTED__) reloadOnce('boot-timeout');
        }, 20000);
      })();
    </script>
